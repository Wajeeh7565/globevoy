{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Review only: service-wide budget, not analytics-only and not a spending cap",
  "Parameters": {
    "AlertEmail": {
      "Type": "String",
      "NoEcho": true
    },
    "MonthlyLimitUsd": {
      "Type": "Number",
      "Default": 10,
      "MinValue": 1
    }
  },
  "Resources": {
    "ServiceBudget": {
      "Type": "AWS::Budgets::Budget",
      "Properties": {
        "Budget": {
          "BudgetName": "globevoy-search-activity-service-watch",
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY",
          "BudgetLimit": {
            "Amount": {
              "Ref": "MonthlyLimitUsd"
            },
            "Unit": "USD"
          },
          "CostFilters": {
            "Service": [
              "Amazon DynamoDB",
              "AWS Lambda",
              "AmazonCloudWatch"
            ]
          }
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 80,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "AlertEmail"
                }
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "FORECASTED",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "AlertEmail"
                }
              }
            ]
          }
        ]
      }
    }
  }
}
