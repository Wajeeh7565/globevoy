# Review-only optimizer and cost trial values. Apply only in an approved environment.
FARE_MAP_READ_PLAN=on
FARE_MAP_BALANCED_POOL=on
FARE_MAP_GUEST_ARRIVAL_RISK=on
FARE_MAP_POOL_SPARE_STRATEGY=adaptive
IGNAV_USAGE_LOG=on

# Leave cap and stay allowance unset for standard two/three-city behavior and default stays.
# Keep FARE_MAP_HUGE_MAX_CITIES, FARE_MAP_FOUR_CITY_LIVE, FARE_MAP_ROUTE_VARIANTS and FARE_MAP_BEAM_TARGET unset.
# IGNAV_FARE_COALESCE is on when unset. Set off only for a controlled comparison or rollback.

# Optional account coordination remains off. Provisioning and activation require approval.
IGNAV_SHARED_LEASE=off
IGNAV_QUOTA_ENABLED=off
IGNAV_QUOTA_APPROVED=false
# IGNAV_TENANT_SCOPE=<stable tenant identifier if credentials are shared>
# IGNAV_CONTROL_TABLE=<approved ledger table name>
# IGNAV_QUOTA_ACCOUNT=<stable provider billing-account identifier>
# IGNAV_QUOTA_DAILY=<approved integer billing-unit allowance per UTC day>
# IGNAV_QUOTA_BILLING=<approved integer billing-unit allowance per period>
# IGNAV_QUOTA_PERIOD=<monthly or approved fixed number of days>
# IGNAV_QUOTA_PERIOD_START=<approved UTC ISO-8601 renewal anchor>
# IGNAV_QUOTA_FARE_UNITS=<approved integer weight for one fare request>
# IGNAV_QUOTA_LINK_UNITS=<approved integer weight for one booking-link request>
# IGNAV_QUOTA_WARN_PERCENT=<approved comma-separated integer thresholds between 1 and 99>
