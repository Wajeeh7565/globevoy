# One complete fare-map pass, run every time the machine boots; the machine then
# switches itself off. An EventBridge Scheduler schedule starts it every 2 days
# (see docs/FARE_MAP_EC2_COLLECTOR.md), so it only runs, and is only billed,
# while collecting.
#
# Maintenance: sudo touch /etc/globevoy/hold keeps the machine on (a running pass
# finishes without powering off; later boots skip the pass). Remove it afterwards.
[Unit]
Description=GlobeVoy fare map: one full Travelpayouts collection pass and the date pass, then power off
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/etc/globevoy/hold

[Service]
Type=oneshot
User=globevoy
WorkingDirectory=/opt/globevoy
EnvironmentFile=/etc/globevoy/fare-map.env
ExecStart=/usr/bin/node ops/fare-map/run-full-pass.cjs
# Then the date pass (more departure dates and stops per route), only with
# FARE_MAP_DATE_PASS=on in fare-map.env. It stops itself after 15 hours and resumes
# at the next boot, so the machine is always off well before the next start.
ExecStart=/usr/bin/node ops/fare-map/run-date-pass.cjs --routes 30 --max-minutes 900
# Main pass about 13 h on t3.micro, date pass about 10 h; stop both past 30 h.
TimeoutStartSec=30h
Nice=10
# Always switch the machine off afterwards, whether the pass finished, stopped
# on an error or timed out, so it never keeps running (and billing) by accident.
# The "+" runs this one line as root. With /etc/globevoy/hold present it stays on.
ExecStopPost=+/bin/sh -c '[ -e /etc/globevoy/hold ] || /usr/bin/systemctl poweroff --no-block'

[Install]
WantedBy=multi-user.target
