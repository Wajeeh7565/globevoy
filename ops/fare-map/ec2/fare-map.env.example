# Copy to /etc/globevoy/fare-map.env (chmod 600, owned by root). No AWS keys here:
# access comes from the instance's IAM role.
AWS_REGION=us-east-2
FARE_MAP_TABLE=globevoy-fare-map
# Name of the Secrets Manager secret that holds the Travelpayouts token
# (plain text, or {"token":"..."}).
TRAVELPAYOUTS_SECRET_ID=globevoy/production/travelpayouts
# Must match the Lambda's values exactly, or prices are converted differently.
# Copy them from Lambda > Configuration > Environment variables (leave out any it does not set).
TRAVELPAYOUTS_PRICE_CURRENCY=
RUB_TO_USD=
CAD_TO_USD=
# Date pass after the main pass (more departure dates and stops per route): on/off.
FARE_MAP_DATE_PASS=on
