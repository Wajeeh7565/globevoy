{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Review only: separate disabled Cognito login history; no pool mutation",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String"
    },
    "ArtifactKey": {
      "Type": "String"
    },
    "RetentionDays": {
      "Type": "Number",
      "MinValue": 1,
      "MaxValue": 90,
      "Default": 30
    }
  },
  "Resources": {
    "Table": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "globevoy-production-login-history",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "WriterRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "LoginHistoryOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:PutItem",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/globevoy-production-login-history"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/globevoy-login-history:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/globevoy-login-history",
        "RetentionInDays": 14
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "Logs",
      "Properties": {
        "FunctionName": "globevoy-login-history",
        "Runtime": "nodejs24.x",
        "Handler": "index.handler",
        "MemorySize": 128,
        "Timeout": 3,
        "Role": {
          "Fn::GetAtt": [
            "WriterRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "Environment": {
          "Variables": {
            "LOGIN_HISTORY_ENABLED": "false",
            "LOGIN_HISTORY_TABLE": "globevoy-production-login-history",
            "LOGIN_HISTORY_RETENTION_DAYS": {
              "Ref": "RetentionDays"
            }
          }
        }
      }
    },
    "PoolPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Function"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "cognito-idp.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:cognito-idp:us-east-2:${AWS::AccountId}:userpool/us-east-2_gr7p2ySyA"
        }
      }
    },
    "ReaderPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Attach only to an approved operator role; never a public/customer role",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "dynamodb:Query",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/globevoy-production-login-history"
              }
            }
          ]
        }
      }
    },
    "WriteFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Trigger runtime errors; writer failures also require review of sanitized WriteFailed log metric",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Function"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "WriteFailureMetric": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "Logs"
        },
        "FilterPattern": "{ $.loginHistory = \"WriteFailed\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": "GlobeVoy/LoginHistory",
            "MetricName": "WriteFailures",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "WriteFailureCountAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "GlobeVoy/LoginHistory",
        "MetricName": "WriteFailures",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "TriggerArn": {
      "Value": {
        "Fn::GetAtt": [
          "Function",
          "Arn"
        ]
      }
    },
    "OperatorPolicyArn": {
      "Value": {
        "Ref": "ReaderPolicy"
      }
    }
  }
}
