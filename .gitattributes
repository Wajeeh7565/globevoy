# Auto detect text files and normalize validation-sensitive source to LF.
# Several legacy regression validators compare raw SHA-256 bytes, so explicit
# LF checkout keeps those checks stable across Windows and Linux.
* text=auto

*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
